# ==============================================================================
# ENVIRONMENT CONFIGURATION MATRIX
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE ENVIRONMENT & PORTS
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
REC_SERVICE_PORT=8000
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. POSTGRESQL, PGBOUNCER & PGADMIN CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=movie_rec_db
POSTGRES_PORT=5432

# pgAdmin 4 Web GUI (Access at http://localhost:5050)
PGADMIN_EMAIL=admin@movierec.local
PGADMIN_PASSWORD=admin_secure_pass
PGADMIN_PORT=5050

# Direct connection (Used for schema migrations and DDL)
DATABASE_URL="postgresql://postgres:postgres_secure_pass@localhost:5432/movie_rec_db?schema=public"

# Pooled connection via PgBouncer (Used by NestJS API at runtime)
DATABASE_POOLED_URL="postgresql://postgres:postgres_secure_pass@localhost:6432/movie_rec_db?schema=public&pgbouncer=true"

# Read Replica URL (For scaling read queries)
DATABASE_REPLICA_URL="postgresql://postgres:postgres_secure_pass@localhost:5433/movie_rec_db?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Asymmetric RS256 keys (Base64-encoded PEM strings)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"

# Cookie Secrets
COOKIE_SECRET="super-secret-cryptographic-salt-change-in-production-32-chars-min"

# OAuth 2.0 Providers
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/oauth/google/callback"

GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
GITHUB_CALLBACK_URL="http://localhost:4000/api/v1/auth/oauth/github/callback"

# ------------------------------------------------------------------------------
# 5. EXTERNAL MOVIE METADATA APIS
# ------------------------------------------------------------------------------
TMDB_API_KEY="your_tmdb_v3_api_key_or_v4_read_access_token"
TMDB_BASE_URL="https://api.themoviedb.org/3"
OMDB_API_KEY="your_omdb_api_key"
OMDB_BASE_URL="https://www.omdbapi.com"

# ------------------------------------------------------------------------------
# 6. ML & RECOMMENDATION SERVICE INTEGRATION
# ------------------------------------------------------------------------------
REC_SERVICE_URL="http://localhost:8000"
EMBEDDING_MODEL_PROVIDER="gemini" # 'gemini' | 'openai' | 'local_sentence_transformers'
GEMINI_API_KEY="your-gemini-api-key"
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------------------------
# 7. CLOUDFLARE R2 OBJECT STORAGE & CDN
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="movie-rec-assets"
R2_PUBLIC_DOMAIN="https://assets.yourmovierecs.com"
